# ─────────────────────────────────────────────────────────────
# MAPMACHINE — Dashboard (Next.js) environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# --- App ---
# Public base URL of the deployed dashboard (used for invite links, redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (PostgreSQL, via Prisma) ---
DATABASE_URL=postgresql://user:password@localhost:5432/mapmachine

# --- Auth / session ---
# Long random string used to sign session tokens (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-string
# Superadmin credentials seeded on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Firebase (client SDK — safe to expose, but still project-specific) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server) ---
# Full service-account JSON, stringified into a single line
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account", ...}

# --- Upstash Redis (rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=plan_xxxxxxxx
RAZORPAY_BUSINESS_PLAN_ID=plan_xxxxxxxx

# --- OpenAI (AI pitch generation) ---
OPENAI_API_KEY=

# --- Scraper service integration ---
# Base URL of the Python FastAPI scraper (see /scraper)
SCRAPER_API_URL=http://localhost:8000
# Shared secret — MUST match SCRAPER_API_SECRET in the scraper's env
SCRAPER_API_SECRET=replace-with-a-shared-secret

# --- Cron ---
# Secret required by the usage-reset cron endpoint
CRON_SECRET=replace-with-a-random-string
