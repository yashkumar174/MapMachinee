# ─────────────────────────────────────────────────────────────
# MAPMACHINE — Scraper (Python / FastAPI) environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Port the FastAPI server listens on (defaults to 8000 in Docker)
PORT=8000

# Shared secret — MUST match SCRAPER_API_SECRET in the dashboard's env.
# The dashboard sends this on every scrape request; the scraper rejects
# requests that don't match.
SCRAPER_API_SECRET=replace-with-a-shared-secret

# --- Optional lead-enrichment providers (used by enrichment.py) ---
# Leave blank to disable enrichment.
APOLLO_API_KEY=
HUNTER_API_KEY=
